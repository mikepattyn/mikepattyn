{
  "name": "@mikepattyn/barbershop-db-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,ui -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "dotnet run --project server-dotnet/BarbershopDbExplorer.Api",
    "dev:client": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.8"
  }
}
